index eb97ecf..c576af1 100755
--- a/files/usr/lib/initcpio/install/omarchy-mac-encrypt
+++ b/files/usr/lib/initcpio/install/omarchy-mac-encrypt
@@ -24,6 +24,9 @@ build() {
     add_file /usr/lib/omarchy/initcpio/omarchy-mac-encrypt-keydev-umount.conf \
         /usr/lib/systemd/system/keydev-root-umount.service.d/omarchy-mac-encrypt.conf 644
 
