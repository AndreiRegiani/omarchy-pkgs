diff --git a/files/usr/lib/omarchy/initcpio/omarchy-mac-encrypt-sysroot.conf b/files/usr/lib/omarchy/initcpio/omarchy-mac-encrypt-sysroot.conf
new file mode 100644
index 0000000..124f58a
--- /dev/null
+++ b/files/usr/lib/omarchy/initcpio/omarchy-mac-encrypt-sysroot.conf
@@ -0,0 +1,4 @@
+[Unit]
+# Ordering alone still lets sysroot.mount run after encryption fails.
+Requires=omarchy-mac-encrypt.service
+After=omarchy-mac-encrypt.service
diff --git a/test/mac-encrypt-test.sh b/test/mac-encrypt-test.sh
index f5fb3cc..cae035b 100644
--- a/test/mac-encrypt-test.sh
+++ b/test/mac-encrypt-test.sh
@@ -162,12 +162,27 @@ if command -v systemd-analyze >/dev/null; then
     >"$verify_units/keydev-root-umount.service"
   install -D -m 644 "$KEYDEV_UMOUNT_DROPIN" "$verify_units/keydev-root-umount.service.d/omarchy-mac-encrypt.conf"
   install -D -m 755 /dev/null "$verify_root/usr/bin/umount"
+  printf '[Unit]\nDefaultDependencies=no\n[Mount]\nWhat=/dev/plaintext\nWhere=/sysroot\nType=btrfs\n' \
+    >"$verify_units/sysroot.mount"
+  install -D -m 755 /dev/null "$verify_root/usr/bin/mount"
+  install -D -m 644 "$FILES/usr/lib/omarchy/initcpio/omarchy-mac-encrypt-sysroot.conf" \
+    "$verify_units/sysroot.mount.d/10-omarchy-mac-encrypt-required.conf"
+  # The successful conversion's What= override must retain the failure gate.
+  install -d "$verify_root/run/systemd/system/sysroot.mount.d"
+  printf '[Mount]\nWhat=/dev/mapper/root\n' \
+    >"$verify_root/run/systemd/system/sysroot.mount.d/omarchy-mac-encrypt.conf"
   verify_out=""
   if probe_out=$(systemd-analyze verify --man=no --root="$verify_root" "$verify_units/probe.service" 2>&1) && [[ -z $probe_out ]]; then
     verify_out=$(systemd-analyze verify --man=no --root="$verify_root" "$verify_units/omarchy-mac-encrypt.service" 2>&1) ||
       verify_out+=$'\n'"exit $?"
     verify_out+=$(systemd-analyze verify --man=no --root="$verify_root" "$verify_units/keydev-root-umount.service" 2>&1) ||
       verify_out+=$'\n'"exit $?"
+    root_graph=$(SYSTEMD_LOG_LEVEL=debug systemd-analyze verify --man=no --root="$verify_root" \
+      "$verify_units/sysroot.mount" 2>&1) || fail "systemd accepts the encryption root-mount failure gate: $root_graph"
+    grep -Fq 'Requires: omarchy-mac-encrypt.service' <<<"$root_graph" &&
+      grep -Fq 'After: omarchy-mac-encrypt.service' <<<"$root_graph" &&
+      grep -Fq 'What: /dev/mapper/root' <<<"$root_graph" ||
+      fail "the loaded sysroot mount requires encryption after applying its mapper override"
     verified=true
   else
     verified=false
