pkgname=pear
pkgver=3.7.0rc.0
pkgrel=1
pkgdesc="Holepunch's peer-to-peer development platform"
arch=('x86_64' 'aarch64')
url='https://github.com/holepunchto/pear'
license=('Apache-2.0')
depends=('glibc' 'gcc-libs')
makedepends=('git' 'nodejs' 'npm')
# The standalone binary from bare-build must not be stripped: stripping it
# removes symbols the standalone runtime needs, just like a Bun executable.
options=('!strip')

_tag=v3.7.0-rc.0
source=("pear::git+https://github.com/holepunchto/pear.git#tag=$_tag"
        'disable-self-update.patch')
sha256sums=('SKIP'
            '26e6550963e4f7df5137a5a9b2081d27a04ea15433f05bf2ded202de8450f62c')

prepare() {
  cd pear
  patch -Np1 --fuzz=0 -i "$srcdir/disable-self-update.patch"
}

build() {
  cd pear

  npm ci --cache "$srcdir/npm-cache" --include=dev
  npm run make
}

package() {
  cd pear

  install -Dm755 out/make/pear "$pkgdir/usr/bin/pear"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
